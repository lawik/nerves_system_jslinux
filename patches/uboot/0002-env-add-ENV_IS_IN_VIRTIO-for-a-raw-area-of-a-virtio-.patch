diff --git a/env/virtio.c b/env/virtio.c
new file mode 100644
index 00000000..0b733a57
--- /dev/null
+++ b/env/virtio.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Environment in a raw area of a virtio block device.
+ *
+ * Modelled on env/scsi.c, but addresses the device by raw block offset
+ * (CONFIG_ENV_OFFSET) instead of a partition, which is how fwup lays out
+ * a U-Boot environment block on Nerves disk images.
+ */
+
+#include <asm/global_data.h>
+#include <blk.h>
+#include <env.h>
+#include <env_internal.h>
+#include <errno.h>
+#include <virtio.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+static env_t envbuf;
+
+static struct blk_desc *env_virtio_blk(void)
+{
+	static bool scanned;
+	struct blk_desc *desc;
+
+	if (!scanned) {
+		virtio_init();
+		scanned = true;
+	}
+
+	desc = blk_get_devnum_by_uclass_id(UCLASS_VIRTIO,
+					   CONFIG_ENV_VIRTIO_DEVICE);
+	if (!desc || !desc->blksz)
+		return NULL;
+	if (CONFIG_ENV_OFFSET % desc->blksz || CONFIG_ENV_SIZE % desc->blksz)
+		return NULL;
+
+	return desc;
+}
+
+static int env_virtio_save(void)
+{
+	struct blk_desc *desc = env_virtio_blk();
+	lbaint_t start, count;
+	int ret;
+
+	if (!desc)
+		return -ENOENT;
+
+	ret = env_export(&envbuf);
+	if (ret)
+		return ret;
+
+	start = CONFIG_ENV_OFFSET / desc->blksz;
+	count = CONFIG_ENV_SIZE / desc->blksz;
+	if (blk_dwrite(desc, start, count, &envbuf) != count)
+		return -EIO;
+
+	return 0;
+}
+
+static int env_virtio_load(void)
+{
+	struct blk_desc *desc = env_virtio_blk();
+	lbaint_t start, count;
+	int ret;
+
+	if (!desc) {
+		env_set_default("virtio block device not found", 0);
+		return -ENOENT;
+	}
+
+	start = CONFIG_ENV_OFFSET / desc->blksz;
+	count = CONFIG_ENV_SIZE / desc->blksz;
+	if (blk_dread(desc, start, count, &envbuf) != count) {
+		env_set_default("virtio block device read failed", 0);
+		return -EIO;
+	}
+
+	/*
+	 * Start from the built-in default environment and layer the stored
+	 * variables on top of it. The stored block is written by fwup and only
+	 * carries the firmware metadata and slot selection; bootcmd and
+	 * friends come from the U-Boot binary.
+	 */
+	env_set_default(NULL, 0);
+	ret = env_import((char *)&envbuf, 1, H_EXTERNAL | H_NOCLEAR);
+	if (ret) {
+		env_set_default("Cannot load environment", 0);
+	} else {
+		gd->env_addr = (ulong)envbuf.data;
+	}
+
+	return ret;
+}
+
+U_BOOT_ENV_LOCATION(virtio) = {
+	.location	= ENVL_VIRTIO,
+	ENV_NAME("virtio")
+	.load		= env_virtio_load,
+	.save		= ENV_SAVE_PTR(env_virtio_save),
+};
diff --git a/include/env_internal.h b/include/env_internal.h
index 0589c435..48eb3ab0 100644
--- a/include/env_internal.h
+++ b/include/env_internal.h
@@ -116,6 +116,7 @@ enum env_location {
 	ENVL_MTD,
 	ENVL_UBI,
 	ENVL_SCSI,
+	ENVL_VIRTIO,
 	ENVL_NOWHERE,
 
 	ENVL_COUNT,
