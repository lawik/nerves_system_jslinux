From ca74f9649ca9db79cddd2c0dc060821b60f44587 Mon Sep 17 00:00:00 2001
From: Lars Wikman <lars@underjord.io>
Date: Fri, 16 Oct 2026 01:08:10 +0200
Subject: [PATCH 2/2] env: add ENV_IS_IN_VIRTIO for a raw area of a virtio
 block device

Load and save the environment from CONFIG_ENV_OFFSET on virtio block
device CONFIG_ENV_VIRTIO_DEVICE, without a partition table lookup. This
matches how fwup lays out a U-Boot environment block on Nerves disk
images, and gives the bootcount/upgrade_available mechanism a writable
backend on virtio-only machines such as TinyEMU.

Signed-off-by: Lars Wikman <lars@underjord.io>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AwVxNHSmhVTamvcP1RTZHp
---
 env/Kconfig            |  19 +++++++-
 env/Makefile           |   1 +
 env/env.c              |   3 ++
 env/virtio.c           | 101 +++++++++++++++++++++++++++++++++++++++++
 include/env_internal.h |   1 +
 5 files changed, 123 insertions(+), 2 deletions(-)
 create mode 100644 env/virtio.c

diff --git a/env/Kconfig b/env/Kconfig
index 7abd82ab..5af3fc6b 100644
--- a/env/Kconfig
+++ b/env/Kconfig
@@ -74,7 +74,8 @@ config ENV_IS_DEFAULT
 		     !ENV_IS_IN_MMC && !ENV_IS_IN_NAND && \
 		     !ENV_IS_IN_NVRAM && !ENV_IS_IN_ONENAND && \
 		     !ENV_IS_IN_REMOTE && !ENV_IS_IN_SPI_FLASH && \
-		     !ENV_IS_IN_UBI && !ENV_IS_IN_MTD && !ENV_IS_IN_SCSI
+		     !ENV_IS_IN_UBI && !ENV_IS_IN_MTD && !ENV_IS_IN_SCSI && \
+		     !ENV_IS_IN_VIRTIO
 	select ENV_IS_NOWHERE
 
 config ENV_IS_NOWHERE
@@ -287,6 +288,20 @@ config ENV_IS_IN_NAND
 	  Currently, CONFIG_ENV_OFFSET_REDUND is not supported when
 	  using CONFIG_ENV_OFFSET_OOB.
 
+config ENV_IS_IN_VIRTIO
+	bool "Environment in a raw area of a virtio block device"
+	depends on VIRTIO_BLK
+	help
+	  Store the environment in a raw (unpartitioned) area of a virtio
+	  block device, CONFIG_ENV_OFFSET bytes from the start of the device
+	  and CONFIG_ENV_SIZE bytes long. Nothing is scanned for; the device
+	  is virtio block device CONFIG_ENV_VIRTIO_DEVICE.
+
+config ENV_VIRTIO_DEVICE
+	int "virtio block device number holding the environment"
+	depends on ENV_IS_IN_VIRTIO
+	default 0
+
 config ENV_IS_IN_SCSI
 	bool "Environment in an SCSI device"
 	depends on SCSI
@@ -621,7 +636,7 @@ config ENV_ADDR_REDUND
 config ENV_OFFSET
 	hex "Environment offset"
 	depends on ENV_IS_IN_EEPROM || ENV_IS_IN_MMC || ENV_IS_IN_NAND || \
-		    ENV_IS_IN_SPI_FLASH || ENV_IS_IN_MTD
+		    ENV_IS_IN_SPI_FLASH || ENV_IS_IN_MTD || ENV_IS_IN_VIRTIO
 	default 0x3f8000 if ARCH_ROCKCHIP && ENV_IS_IN_MMC
 	default 0x140000 if ARCH_ROCKCHIP && ENV_IS_IN_SPI_FLASH
 	default 0xF0000 if ARCH_SUNXI
