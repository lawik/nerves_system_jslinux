index d11b8770..dd28cb1c 100644
--- a/env/Makefile
+++ b/env/Makefile
@@ -29,5 +29,6 @@ obj-$(CONFIG_$(PHASE_)ENV_IS_IN_SPI_FLASH) += sf.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_MTD) += mtd.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_FLASH) += flash.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_SCSI) += scsi.o
+obj-$(CONFIG_$(PHASE_)ENV_IS_IN_VIRTIO) += virtio.o
 
 CFLAGS_embedded.o := -Wa,--no-warn -DENV_CRC=$(shell tools/envcrc 2>/dev/null)
diff --git a/env/env.c b/env/env.c
index 7a9c96b4..3c619588 100644
--- a/env/env.c
+++ b/env/env.c
@@ -49,6 +49,9 @@ static enum env_location env_locations[] = {
 #ifdef CONFIG_ENV_IS_IN_SCSI
 	ENVL_SCSI,
